SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=chefy_db
DB_USER=chefy_user
DB_PASSWORD=chefy_password
DB_HOST=localhost
DB_PORT=5432

# Redis (for future caching/celery)
